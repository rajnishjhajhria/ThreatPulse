# ==============================================================
# AI-Shield: API Keys Configuration (ALL KEYS ARE OPTIONAL)
# The application will use local fallbacks / demo mode if keys are blank.
# ==============================================================

# Google Gemini API (Free key from https://aistudio.google.com/)
# Used for: AI Security Prompt Injection Tests and advanced toxicity
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
# Used for: Moderation API (Free endpoint)
OPENAI_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/)
# Alternative LLM backend for AI security testing
ANTHROPIC_API_KEY=

# Google Safe Browsing API Key (Google Cloud Console)
# Used for: Scanning phishing, malware, and deceptive URLs
SAFE_BROWSING_API_KEY=

# Reddit API Credentials (https://www.reddit.com/prefs/apps)
# Used for: Fetching live posts from any subreddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ==============================================================
# MongoDB Database Configuration
# ==============================================================
# Local MongoDB: mongodb://localhost:27017/
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=threatpulse
